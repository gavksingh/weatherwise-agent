# OpenWeatherMap API Key (required for MCP server)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# LLM Provider: "google" or "groq"
LLM_PROVIDER=google

# Google Gemini API Key (required if LLM_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# --- Docker-only settings (set automatically by docker-compose) ---

# MCP server transport: "stdio" (local) or "sse" (Docker)
# MCP_TRANSPORT=sse

# MCP server URL for agent backend to connect via SSE
# MCP_SERVER_URL=http://mcp-server:8001/sse

# Backend URL for frontend API proxy
# API_URL=http://agent-backend:8000
